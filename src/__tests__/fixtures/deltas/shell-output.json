      "update": {
        "type": "tool-call-completed",
        "callId": "call-output",
        "modelCallId": "model-call-output",
        "toolCall": {
          "type": "shell",
          "args": { "command": "echo hi" },
          "result": {
            "status": "success",
            "value": {
              "exitCode": 0,
              "signal": "",
              "stdout": "hi\n",
              "stderr": "",
              "executionTime": 2
            }
          }
        }
      }
    }
  ],
  "result": { "id": "run-output", "status": "finished" }
}
