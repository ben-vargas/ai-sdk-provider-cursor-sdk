{
  "description": "shell output is raw-only without the experimental flag",
  "events": [
    {
      "update": {
        "type": "tool-call-started",
        "callId": "call-output",
        "modelCallId": "model-call-output",
        "toolCall": { "type": "shell", "args": { "command": "echo hi" } }
      }
    },
    { "update": { "type": "shell-output-delta", "event": { "stdout": "hi\n" } } },
