{
  "name": "ai-sdk-provider-cursor-sdk",
  "version": "1.0.1",
  "description": "AI SDK v7 provider for the Cursor Agent SDK (@cursor/sdk)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "docs/**/*",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "author": "Ben Vargas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ben-vargas/ai-sdk-provider-cursor-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "ai-sdk",
    "cursor",
    "cursor-sdk",
    "cursor-agent",
    "language-model",
    "llm",
    "provider"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "CURSOR_INTEGRATION=1 vitest run src/__tests__/integration",
    "smoke:consumer": "npm run build && node scripts/smoke-consumer.mjs",
    "validate": "npm run build && npm run typecheck && npm run format && npm run lint && npm run test"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.2",
    "@ai-sdk/provider-utils": "^5.0.5",
    "@cursor/sdk": "1.0.31"
  },
  "peerDependencies": {
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "ai": "^7.0.16",
    "eslint": "^9.28.0",
    "prettier": "^3.6.2",
    "publint": "^0.3.0",
    "tsup": "8.5.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.6.0",
    "vitest": "3.2.4",
    "zod": "^4.1.12"
  }
}
